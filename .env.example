KAROTTER_API_KEY=
KAROTTER_AUTH_MODE=oauth
KAROTTER_API_BASE_URL=https://karotter.com/api/developer
KAROTTER_OAUTH_BASE_URL=https://karotter.com/api/oauth
KAROTTER_OAUTH_CLIENT_ID=
KAROTTER_OAUTH_CLIENT_SECRET=
KAROTTER_OAUTH_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/oauth/callback
KAROTTER_OAUTH_SCOPE=profile offline_access
KAROTTER_OAUTH_TOKEN_PATH=./data/oauth.json
KAROTTER_OAUTH_REFRESH_TOKEN=
TBOT_SETUP_SECRET=
TBOT_USERNAME=tbot
TBOT_TIME_ZONE=Asia/Tokyo
POLL_INTERVAL_MS=15000
POLL_PAGE_LIMIT=50
MAX_NOTIFICATIONS_PER_TICK=10
HTTP_TIMEOUT_MS=15000
KAROTTER_REQUESTS_PER_MINUTE=55
AVATAR_ALLOWED_HOSTS=karotter.com,api.karotter.com
STATE_PATH=./data/state.json
ENABLE_POLLING=true
PORT=3000
